+def _enclosing_workspace_cargo_toml(rctx, package_dir):
+    module_root = rctx.path(Label("@@//:Cargo.toml")).dirname
+    # A path crate outside the root workspace inherits `workspace = true`
+    # package fields (version, edition, license, ..) from the nearest enclosing
+    # manifest with a [workspace] table.
+    dir = package_dir.dirname
+    for _ in range(32):
+        if dir == module_root:
+            break
+        manifest = dir.get_child("Cargo.toml")
+        if manifest.exists:
+            rctx.watch(manifest)
+            manifest_json = run_toml2json(rctx, manifest)
+            if manifest_json.get("workspace"):
+                return manifest_json
+        if dir.dirname == dir:
+            break
+        dir = dir.dirname
+    return {}
