+def _enclosing_workspace_toml(mctx, package_dir, module_root):
+    # A path package inherits `workspace = true` fields from the nearest
+    # enclosing manifest with a [workspace] table, which for a package outside
+    # the root workspace is not the root Cargo.toml.
+    # The search stops below the module root: nothing above it is ours.
+    dir = package_dir
+    for _ in range(32):
+        parent = paths.dirname(dir)
+        if parent == dir or parent == module_root:
+            break
+        dir = parent
+        manifest = paths.join(dir, "Cargo.toml")
+        if mctx.path(manifest).exists:
+            mctx.watch(manifest)
+            manifest_json = run_toml2json(mctx, manifest)
+            if manifest_json.get("workspace"):
+                return manifest_json
+    return {}
+
