+def _path_package_dirs_by_key(mctx, cargo_path, manifest_dirs):
+    # Members of every workspace that holds an already-resolved path package:
+    # a path package no manifest of ours names is still a member of one of them.
+    dirs = {}
+    seen = {}
+    for manifest_dir in manifest_dirs:
+        # A new member of the workspace must re-run resolution.
+        mctx.watch(manifest_dir + "/Cargo.toml")
+        result = mctx.execute(
+            [cargo_path, "metadata", "--no-deps", "--format-version=1", "--quiet", "--manifest-path", manifest_dir + "/Cargo.toml"],
+            working_directory = manifest_dir,
+        )
+        if result.return_code != 0:
+            fail(result.stdout + "\n" + result.stderr)
+        metadata = json.decode(result.stdout)
+        if metadata["workspace_root"] in seen:
+            continue
+        seen[metadata["workspace_root"]] = True
+        mctx.watch(metadata["workspace_root"] + "/Cargo.toml")
+        for member in metadata["packages"]:
+            mctx.watch(member["manifest_path"])
+            if not member.get("source"):
+                dirs[(member["name"], member["version"])] = normalize_path(paths.dirname(member["manifest_path"]))
+    return dirs
