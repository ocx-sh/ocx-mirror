# The acceptance suite as ONE cached Bazel test (adr_bazel_crate_split.md § C7,
# D6): `pytest -n auto` inside a single `sh_test`. ocx runs one target per
# module; here any binary rebuild re-keys every module anyway, and ocx measured
# per-module exclusive-serial at 1421 s against 160 s for one parallel run.
#
# Tags: `exclusive` serialises it against every other test of the invocation
# (it drives shared registries; never a global `--local_test_jobs`);
# `no-sandbox` gives the runner the source tree the suite resolves through
# `__file__`. Never `external` (disables result caching) or `local` (its
# `no-remote` half drops the disk-cache hit on a fresh server) — nor any other
# cache-suppressing tag: `task bazel:tag:guard` reds one.
#
# Its result is REMOTE-cached (diverging from ocx, whose acceptance verdicts
# never leave the host — ocx test/bazel.bzl "None of these results reaches
# another machine"): CI's main-push lane uploads it and every later run on the
# same tree reads it. That is only sound while `data` covers everything the
# suite reads, so every read outside test/ is declared here — including the
# ocx submodule files, through @ocx_test — and nothing host-side is left to
# pick a verdict (see `env_inherit`). Residuals the key cannot see: the
# running containers' state and mutable image tags (`registry:2`).

load("@rules_shell//shell:sh_test.bzl", "sh_test")

sh_test(
    name = "acceptance",
    timeout = "long",
    srcs = ["bazel_accept.sh"],
    args = [
        "$(rlocationpath //:ocx-mirror)",
        "$(rlocationpath @tools//:ocx)",
        "$(rlocationpath @tools//:uv)",
        "$(rlocationpath @ocx_test//:docker-compose.yml)",
    ],
    # `@tools//:ocx` / `@tools//:uv` are rules_ocx launchers whose text bakes
    # this host's absolute `$OCX_HOME` store paths, so the key is per host
    # path: every CI runner (/home/runner) shares entries, a developer host
    # re-runs once and then hits its own. Over-keyed, never under-keyed — the
    # pinned binaries' content is `//:ocx.lock` (declared), and a lazy,
    # path-free launcher would re-export ocx's pinned env into every `ocx` the
    # suite spawns with its own per-test OCX_HOME.
    data = [
        "//:ocx.lock",
        "//:ocx.toml",
        "//:ocx-mirror",
        "//:renovate.json",
        "//:src/command/package/pipeline/generate/ci/matrix.rs",
        "//:tests/fixtures/wheels/console_pkg-1.0.0-py3-none-any.whl",
        # The Sigstore stack the runner brings up and the golden cosign keys
        # test_signing.py reads, both from the pinned submodule.
        "@ocx_test//:docker-compose.yml",
        "@ocx_test//:golden_keys",
        "@ocx_test//:sigstore",
        "@tools//:ocx",
        "@tools//:uv",
    ] + glob(
        # All of test/, so a new top-level module (a conftest plugin, a
        # helper) is an input the day it lands, not a cached green after.
        ["**"],
        exclude = [
            # The runner, already `srcs`.
            "bazel_accept.sh",
            # pytest writes bytecode beside every module it imports; globbed,
            # it would re-key the target on every run and the rerun would
            # never cache. The rest are generated by the suite or its tools
            # (test/.gitignore, .gitignore): caches, the venv, the staged
            # binaries, the scratch HOME.
            "**/__pycache__/**",
            "**/*.pyc",
            "**/*.log",
            ".out/**",
            ".pytest_cache/**",
            ".ruff_cache/**",
            ".venv/**",
            "bin/**",
            "home/**",
            "results/**",
        ],
    ),
    # NOT part of the action key: a result recorded under one value is served
    # under another (remotely too). So this list holds only what cannot pick a
    # verdict — what the runner itself needs, and how to reach the Docker
    # daemon; the suite gets none of its knobs from here (the runner pins the
    # registries' defaults, the Sigstore compose file, project and ports):
    #   HOME            the runner's own roots (uv cache, TMPDIR, lock); the
    #                   suite and every binary it spawns get a fresh per-run
    #                   HOME, so no ~/.netrc, ~/.config/ocx or warm ~/.ocx of
    #                   this host reaches a verdict.
    #   USER            pytest's basetemp directory name only.
    #   DOCKER_HOST, XDG_RUNTIME_DIR, DOCKER_CONFIG
    #                   which daemon and CLI config (plugins, context) `docker
    #                   compose` uses; the images and ports it runs are the
    #                   declared compose files.
    # Dropped on purpose: `CI` (no reader — the harness never reads it, and
    # neither binary reads it at run time), `REGISTRY`/`MIRROR_REGISTRY`/
    # `ZOT_REGISTRY` and `OCX_SIGSTORE_COMPOSE`/`OCX_TEST_*_PORT` (each moved a
    # verdict's stack without moving the key).
    env_inherit = [
        "DOCKER_CONFIG",
        "DOCKER_HOST",
        "HOME",
        "USER",
        "XDG_RUNTIME_DIR",
    ],
    tags = [
        "exclusive",
        "no-sandbox",
    ],
)
