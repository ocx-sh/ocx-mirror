load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "ocx_mirror_test_support",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_mirror_test_support"},
    version = "0.6.4",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ),
)

rust_test(
    name = "ocx_mirror_test_support_test",
    aliases = aliases(),
    crate = ":ocx_mirror_test_support",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_mirror_test_support"},
    deps = all_crate_deps(
        cargo_only = True,
        normal_dev = True,
    ),
)

# Every Rust source plus the manifest, for the root's cross-crate scans
# (//:source_scan walks `src/`, //:workspace_structure runs `cargo metadata`
# and reads every `.rs`).
filegroup(
    name = "rust_sources",
    srcs = glob(["**/*.rs"]) + ["Cargo.toml"],
)
