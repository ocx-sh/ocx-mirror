load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "ocx_mirror_error",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_mirror_error"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True) + [
        "//crates/ocx_mirror_http",
        "//crates/ocx_mirror_report",
        "//crates/ocx_mirror_source",
    ],
)

rust_test(
    name = "ocx_mirror_error_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":ocx_mirror_error",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_mirror_error"},
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/ocx_mirror_test_support",
    ],
)
