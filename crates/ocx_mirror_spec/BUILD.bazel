load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "ocx_mirror_spec",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_mirror_spec"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True) + [
        "//crates/ocx_mirror_error",
        "//crates/ocx_mirror_http",
        "//crates/ocx_mirror_source",
    ],
)

# The Cargo `jsonschema` feature (`dep:schemars`, `ocx_mirror_source/jsonschema`);
# //crates/ocx_mirror_source:ocx_mirror_source_jsonschema says why a variant.
rust_library(
    name = "ocx_mirror_spec_jsonschema",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    crate_features = ["jsonschema"],
    crate_name = "ocx_mirror_spec",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_mirror_spec"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True) + [
        "//crates/ocx_mirror_error:ocx_mirror_error_jsonschema",
        "//crates/ocx_mirror_http",
        "//crates/ocx_mirror_source:ocx_mirror_source_jsonschema",
        "@crates__schemars-1.2.1//:schemars",
    ],
)

# The unit tests under the feature — `src/dist/tests.rs` holds a
# `#[cfg(feature = "jsonschema")]` case. `cargo check --all-targets` compiles
# it and runs nothing; this twin is compiled by `//:jsonschema` and, `manual`,
# never run by `bazel test //...`, so the test floor sees no second target.
rust_test(
    name = "ocx_mirror_spec_jsonschema_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":ocx_mirror_spec_jsonschema",
    crate_features = ["jsonschema"],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    tags = ["manual"],
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/ocx_mirror_test_support",
    ],
)

rust_test(
    name = "ocx_mirror_spec_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    # `--test-threads=1`: tests here mutate the process environment
    # (`EnvRestore`, `set_var`) under `OCX_ENV_LOCK`, but libtest runs every
    # case as a thread of one process and other cases read the environment
    # unlocked. nextest gives each case its own process; Bazel drives libtest.
    # A target without the flag gains it with its first env-mutating case.
    args = [
        "--test-threads=1",
    ],
    crate = ":ocx_mirror_spec",
    # `CARGO_MANIFEST_DIR/../../tests/fixtures`, resolved in the runfiles tree.
    data = ["//:test_fixtures"],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_mirror_spec"},
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/ocx_mirror_test_support",
    ],
)

# Every Rust source plus the manifest, for the root's cross-crate scans
# (//:source_scan walks `src/`, //:workspace_structure runs `cargo metadata`
# and reads every `.rs`).
filegroup(
    name = "rust_sources",
    srcs = glob(["**/*.rs"]) + ["Cargo.toml"],
)
