load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "ocx_mirror_pipeline",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_mirror_pipeline"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True) + [
        "//crates/ocx_mirror_error",
        "//crates/ocx_mirror_http",
        "//crates/ocx_mirror_report",
        "//crates/ocx_mirror_spec",
    ],
)

# No `jsonschema` feature of its own; the twin that compiles against the
# featured error and spec crates, as Cargo's feature unification does
# (//crates/ocx_mirror_error:ocx_mirror_error_jsonschema says why).
rust_library(
    name = "ocx_mirror_pipeline_jsonschema",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    crate_name = "ocx_mirror_pipeline",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_mirror_pipeline"},
    version = "0.6.2",
    deps = all_crate_deps(normal = True) + [
        "//crates/ocx_mirror_error:ocx_mirror_error_jsonschema",
        "//crates/ocx_mirror_http",
        "//crates/ocx_mirror_report",
        "//crates/ocx_mirror_spec:ocx_mirror_spec_jsonschema",
    ],
)

rust_test(
    name = "ocx_mirror_pipeline_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    # `--test-threads=1`: tests here mutate the process environment
    # (`EnvRestore`, `set_var`) under `OCX_ENV_LOCK`, but libtest runs every
    # case as a thread of one process and other cases read the environment
    # unlocked. nextest gives each case its own process; Bazel drives libtest.
    # A target without the flag gains it with its first env-mutating case.
    # The flag is also what makes the one cwd-mutating case
    # (`registry_sync::cache::tests::digest_file_and_locks_dir_stay_outside_output_for_every_output_shape`)
    # safe here: the cwd is process-wide, and one thread means no other case
    # runs while it is changed (its `RestoreCwd` puts it back, on panic too).
    args = ["--test-threads=1"],
    crate = ":ocx_mirror_pipeline",
    # `CARGO_MANIFEST_DIR/../../tests/fixtures`, resolved in the runfiles tree.
    data = ["//:test_fixtures"],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_mirror_pipeline"},
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/ocx_mirror_test_support",
    ],
)

# Every Rust source plus the manifest, for the root's cross-crate scans
# (//:source_scan walks `src/`, //:workspace_structure runs `cargo metadata`
# and reads every `.rs`).
filegroup(
    name = "rust_sources",
    srcs = glob(["**/*.rs"]) + ["Cargo.toml"],
)
