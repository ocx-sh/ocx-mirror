load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//:__subpackages__"])

rust_library(
    name = "ocx_mirror_source",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_mirror_source"},
    version = "0.6.4",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//crates/ocx_mirror_http",
    ],
)

# The Cargo `jsonschema` feature (`dep:schemars`): Bazel compiles no feature a
# rule does not name, so the schemars derives compile only in this variant.
# Same crate name, its own output. `//:jsonschema` builds the variant graph.
rust_library(
    name = "ocx_mirror_source_jsonschema",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = glob(
        ["src/**"],
        allow_empty = True,
        exclude = ["src/**/*.rs"],
    ),
    crate_features = ["jsonschema"],
    crate_name = "ocx_mirror_source",
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_mirror_source"},
    version = "0.6.4",
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//crates/ocx_mirror_http",
        "@crates//:schemars",
    ],
)

rust_test(
    name = "ocx_mirror_source_test",
    aliases = aliases(),
    # `--test-threads=1`: tests here mutate the process environment
    # (`EnvRestore`, `set_var`) under `OCX_ENV_LOCK`, but libtest runs every
    # case as a thread of one process and other cases read the environment
    # unlocked. nextest gives each case its own process; Bazel drives libtest.
    # A target without the flag gains it with its first env-mutating case.
    args = [
        "--test-threads=1",
    ],
    crate = ":ocx_mirror_source",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/ocx_mirror_source"},
    deps = all_crate_deps(
        cargo_only = True,
        normal_dev = True,
    ) + [
        "//crates/ocx_mirror_test_support",
    ],
)

# Every Rust source plus the manifest, for the root's cross-crate scans
# (//:source_scan walks `src/`, //:workspace_structure runs `cargo metadata`
# and reads every `.rs`).
filegroup(
    name = "rust_sources",
    srcs = glob(["**/*.rs"]) + ["Cargo.toml"],
)
