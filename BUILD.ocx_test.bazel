# BUILD file of @ocx_test (MODULE.bazel): external/ocx/test, read by
# //test:acceptance. Globs, so a file ocx adds under either tree is an input
# the day the submodule pointer moves.

package(default_visibility = ["//visibility:public"])

exports_files(["docker-compose.yml"])

# Everything the stack mounts and the harness reads beside the compose file.
filegroup(
    name = "sigstore",
    srcs = glob(["sigstore/**"]),
)

# test/tests/test_signing.py's cosign.key / cosign.pub.
filegroup(
    name = "golden_keys",
    srcs = glob(["tests/fixtures/golden/keys/**"]),
)
