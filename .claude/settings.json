{
  "claudeMdExcludes": [
    "**/.claude/rules/rust-cargo/**",
    "**/.claude/rules/rust-quality/**",
    "**/.claude/rules/bazel-quality/**",
    "**/.claude/rules/docs-quality/**",
    "**/.claude/rules/python-quality/**"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_use_guard.py\""
          }
        ]
      }
    ]
  }
}
