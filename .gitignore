venv/

# =============================================================================
# Logs / runtime
# =============================================================================
*.log
# grim client output is committed whole: a missing fixture fails grim:check on a fresh clone.
!.claude/skills/**/*.log
!.agents/skills/**/*.log
!.opencode/**/*.log
*.pid
*.sock

# Agent worktrees (see workflow-swarm.md) — never committed.
# Only the transient checkouts; .agents/memory/ is team-shared and tracked.
.agents/worktrees/

# Goal-run drafts and long-job logs (survive the hourly target/ and /tmp wipes).
/.tmp/

/bazel-*
/.bazelrc.user
