load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# `find -path` patterns buildifier must not walk (it never reads .bazelignore).
# `./.tmp/*` stays LAST: buildifier_prebuilt pairs `-prune` with the last
# pattern only, and .tmp may hold unreadable scratch that makes `find` exit 1.
_NOT_OURS = [
    "./.agents/*",
    "./.git/*",
    "./.ocx/*",
    "./bazel-*/*",
    # buildifier: disable=external-path — a `find` pattern, not a label.
    "./external/*",
    "./target/*",
    "./test/.venv/*",
    "./.tmp/*",
]

buildifier(
    name = "buildifier.check",
    exclude_patterns = _NOT_OURS,
    lint_mode = "warn",
    mode = "diff",
)

buildifier(
    name = "buildifier",
    exclude_patterns = _NOT_OURS,
    lint_mode = "fix",
    mode = "fix",
)

rust_library(
    name = "ocx_mirror",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/main.rs",
            "src/tracing_init.rs",
        ],
    ),
    aliases = aliases(),
    # The six `include_str!` workflow templates.
    compile_data = glob(
        ["src/**"],
        exclude = ["src/**/*.rs"],
    ),
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    # Stand-in for the package's `build.rs`, which Bazel never runs (as in
    # ocx): the fixed provenance a cargo `__testing` build bakes, read from
    # the same file. Every Bazel build is a test build, so no commit, dirty
    # flag or CI variable reaches the binary and nothing re-keys per commit.
    # `rust_test(crate = ":ocx_mirror")` inherits it.
    rustc_env_files = ["testing_provenance.env"],
    version = "0.6.2",
    deps = all_crate_deps(normal = True) + [
        "//crates/ocx_mirror_error",
        "//crates/ocx_mirror_http",
        "//crates/ocx_mirror_pipeline",
        "//crates/ocx_mirror_report",
        "//crates/ocx_mirror_source",
        "//crates/ocx_mirror_spec",
    ],
)

rust_binary(
    name = "ocx-mirror",
    srcs = [
        "src/main.rs",
        "src/tracing_init.rs",
    ],
    aliases = aliases(),
    crate_root = "src/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "0.6.2",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [":ocx_mirror"],
)

# The six first-party crates the root package depends on; its integration
# tests (`tests/*.rs`) see them as Cargo gives an integration test every
# normal dependency of its package.
_FIRST_PARTY = [
    "//crates/ocx_mirror_error",
    "//crates/ocx_mirror_http",
    "//crates/ocx_mirror_pipeline",
    "//crates/ocx_mirror_report",
    "//crates/ocx_mirror_source",
    "//crates/ocx_mirror_spec",
]

rust_test(
    name = "ocx_mirror_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    # `--test-threads=1`: tests here mutate the process environment
    # (`EnvRestore`, `set_var`) under `OCX_ENV_LOCK`, but libtest runs every
    # case as a thread of one process and other cases read the environment
    # unlocked. nextest gives each case its own process; Bazel drives libtest.
    # A target without the flag gains it with its first env-mutating case.
    args = ["--test-threads=1"],
    crate = ":ocx_mirror",
    data = [":test_fixtures"],
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    # Relative: `env!("CARGO_MANIFEST_DIR")` is baked in at compile time and
    # read at run time from the runfiles root, where `tests/fixtures` lives.
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/ocx_mirror_test_support",
    ],
)

rust_test(
    name = "ocx_mirror_bin_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":ocx-mirror",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/ocx_mirror_test_support",
    ],
)

# Every workspace member's Rust sources and manifest, for the two scans that
# see the whole workspace. Both targets link every first-party crate anyway,
# so declaring the sources adds no rdep edge they did not already have.
_MEMBER_SOURCES = [
    "//crates/ocx_mirror_error:rust_sources",
    "//crates/ocx_mirror_http:rust_sources",
    "//crates/ocx_mirror_pipeline:rust_sources",
    "//crates/ocx_mirror_report:rust_sources",
    "//crates/ocx_mirror_source:rust_sources",
    "//crates/ocx_mirror_spec:rust_sources",
    "//crates/ocx_mirror_test_support:rust_sources",
]

# One rust_test per `tests/*.rs`, with the data and environment each one reads.
# Every case runs here: crates/TEST_TARGET_MAP.toml has no `[[excluded]]` row.
[
    rust_test(
        name = name,
        srcs = ["tests/%s.rs" % name],
        aliases = aliases(
            normal = True,
            normal_dev = True,
            proc_macro = True,
            proc_macro_dev = True,
        ),
        # No `--test-threads=1`: no case in tests/*.rs mutates the process
        # environment; the first one that does needs it (see :ocx_mirror_test).
        data = data,
        edition = "2024",
        env = env,
        proc_macro_deps = all_crate_deps(
            proc_macro = True,
            proc_macro_dev = True,
        ),
        # `CARGO`: `workspace_structure` falls back to `env!("CARGO")` when the
        # runtime `CARGO` is unset; under Bazel `env` below always sets it.
        rustc_env = {
            "CARGO": "cargo",
            "CARGO_MANIFEST_DIR": ".",
        },
        deps = all_crate_deps(
            normal = True,
            normal_dev = True,
        ) + _FIRST_PARTY + [
            ":ocx_mirror",
            "//crates/ocx_mirror_test_support",
        ],
    )
    for name, data, env in [
        (
            "log_targets",
            [
                "crates/crate_map.toml",
                "//docs:reference/cli.md",
            ],
            {},
        ),
        (
            "registry_spec_validation",
            [":test_fixtures"],
            {},
        ),
        # The factory walk reads `src/` and every `crates/*/src`; the wheel
        # comparison reads ocx_python's original through @ocx_python_wheels,
        # handed over by runfiles path (the submodule is no `_main` path).
        (
            "source_scan",
            glob(["src/**"]) + _MEMBER_SOURCES + [
                "tests/fixtures/wheels/console_pkg-1.0.0-py3-none-any.whl",
                "@ocx_python_wheels//:console_pkg-1.0.0-py3-none-any.whl",
            ],
            {"OCX_PYTHON_WHEEL": "$(rootpath @ocx_python_wheels//:console_pkg-1.0.0-py3-none-any.whl)"},
        ),
        (
            "spec_validation",
            [":test_fixtures"],
            {},
        ),
        # `real_workspace_has_no_violations` runs `cargo metadata --no-deps
        # --offline` over the declared manifests with the toolchain's own
        # cargo (never a host one), then scans every `.rs` under src/, crates/
        # and tests/. `--no-deps` needs no registry and no external/ocx
        # manifest; the member view it returns equals the resolved one.
        (
            "workspace_structure",
            glob([
                "src/**/*.rs",
                "tests/**/*.rs",
            ]) + _MEMBER_SOURCES + [
                "Cargo.toml",
                "crates/crate_map.toml",
                "@rules_rust//rust/toolchain:current_cargo_files",
            ],
            {"CARGO": "$(rootpath @rules_rust//rust/toolchain:current_cargo_files)"},
        ),
    ]
]

# Fixtures and golden files the unit tests read through CARGO_MANIFEST_DIR.
filegroup(
    name = "test_fixtures",
    srcs = glob([
        "tests/fixtures/**",
        "tests/golden/**",
    ]),
    visibility = ["//crates:__subpackages__"],
)

# Bazel 9 exports no source file implicitly; the acceptance target reads these.
# renovate.json and matrix.rs: test_renovate_managers.py greps them (the
# templates it also greps are `include_str!`-embedded, so the binary carries
# them); the wheel: test_mirror_{pypi,mount,libc}.py push it. Undeclared, an
# edit to any of them would be served a cached acceptance green.
exports_files([
    "ocx.lock",
    "ocx.toml",
    "renovate.json",
    "src/command/package/pipeline/generate/ci/matrix.rs",
    "tests/fixtures/wheels/console_pkg-1.0.0-py3-none-any.whl",
])

# The docs site's two root-level inputs (docs/BUILD.bazel `//docs:site`):
# mkdocs.yml, and CHANGELOG.md, which docs/changelog.md snippet-includes.
exports_files(
    [
        "CHANGELOG.md",
        "mkdocs.yml",
    ],
    visibility = ["//docs:__pkg__"],
)
