"""ocx-mirror — the Bazel module (Linux test loop; release and non-Linux stay cargo).

Pins copy ocx's MODULE.bazel (external/ocx). `compatibility_level` is absent on
purpose: it is non-functional from Bazel 9.1.0 on.
"""

module(
    name = "ocx_mirror",
    version = "0.6.2",
)

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4")

# Resolved by the `git_override` below, not the registry.
bazel_dep(name = "rules_ocx", version = "0.4.0")

# Equal to rust-toolchain.toml's channel (`task bazel:pin:check`).
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Root manifest only: the splice discovers `members = ["crates/*"]`, and the
# ocx crates (path deps into external/ocx) render as `@crates//:ocx_*`. The
# `[patch.crates-io]` forks bind through the same splice (`task bazel:patch:check`).
# `lockfile =` is mandatory — without it every build re-splices. It is
# gitignored: it records absolute paths of the generating checkout, so
# `task bazel:bootstrap` regenerates it per checkout.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:Cargo.bazel.lock.json",
    manifests = ["//:Cargo.toml"],
)

# `crates__schemars-<v>`: the `jsonschema` feature variants' optional
# dependency (`crates/ocx_mirror_source/BUILD.bazel`). crate_universe aliases
# only the dependencies the default features enable, so the spoke the ocx
# crates already link is imported by its versioned name — the same schemars
# crate, never a second copy. A schemars bump in Cargo.lock renames the spoke
# and fails every Bazel command (measured: an extension exception on a plain
# query) until this line and the BUILD labels follow; `bazel:pin:check`, which
# runs no Bazel, names the mismatch first.
use_repo(crate, "crates", "crates__schemars-1.2.1")

# rules_ocx has no BCR release with Bazel 9 support yet; same commit as ocx.
git_override(
    module_name = "rules_ocx",
    commit = "9ced5ffb79a77d37d6f479498bf32517a49b3dc7",
    remote = "https://github.com/ocx-sh/rules_ocx",
)

# `@tools//:<bin>` from the same ocx.toml/ocx.lock pair the shell hook reads.
ocx = use_extension("@rules_ocx//ocx:extensions.bzl", "ocx")
ocx.project(
    name = "tools",
    ocx_lock = "//:ocx.lock",
    ocx_toml = "//:ocx.toml",
)
use_repo(ocx, "tools")

# The external/ocx submodule files tests read, as real inputs. The submodule is
# no package of this repo (`//...` skips `external/`, and its BUILD files load
# ocx's own graph), so each directory is a local repository with a BUILD file
# of ours; `build_file` rather than `build_file_content`, because the rule
# deletes the symlinked ocx BUILD.bazel before placing ours. The contents are
# the pinned submodule tree — tracked, so every checkout of one superproject
# commit keys identically, CI included (unlike a host path).
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

# The Sigstore stack //test:acceptance brings up and signs against: compose
# file, sigstore/ (keys, service configs, token minter, trusted root), and
# the golden cosign key pair test_signing.py reads.
new_local_repository(
    name = "ocx_test",
    build_file = "//:BUILD.ocx_test.bazel",
    path = "external/ocx/test",
)

# ocx_python's wheel fixture, which //:source_scan proves the root copy equals.
new_local_repository(
    name = "ocx_python_wheels",
    build_file = "//:BUILD.ocx_python_wheels.bazel",
    path = "external/ocx/crates/ocx_python/tests/fixtures/wheels",
)

# ---------------------------------------------------------------------------
# The docs site toolchain (`//docs:site`) — one contiguous block, WP-C.
# ---------------------------------------------------------------------------

# rules_python is the one Bazel-side route to a hermetic interpreter plus a
# hashed PyPI closure; `@tools//` exposes executables only (a uv launcher), so
# it cannot feed a sandboxed action a pinned site-packages. 2.3.4 is the BCR
# head and presubmits against Bazel 9.x.
bazel_dep(name = "rules_python", version = "2.3.4")

# BZL-PY-01: both calls carry the literal version, or the interpreter rides
# rules_python's rolling default and moves on any bump. 3.14 = the version the
# acceptance venv (`test/`) resolves to, and the `--python-version` the lock
# was compiled for.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.14")
python.toolchain(python_version = "3.14")

# BZL-PY-03: bound to that interpreter. The wheels come from the lock's own
# sha256 pins through the repository cache — nothing is fetched inside the
# build action, which is what lets `//docs:site` run offline and sandboxed and
# live on the remote cache (docs/BUILD.bazel says why that differs from ocx).
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "docs_pip",
    python_version = "3.14",
    requirements_lock = "//docs:requirements.lock",
)
use_repo(pip, "docs_pip")
