# Release target platforms, one per Rust triple build-matrix.yml ships and
# named after it (`task bazel:build:release TARGET=<triple>`), so a triple is
# the one name a workflow, an artifact and a `--platforms` flag share.
#
# `@zig_sdk//libc:musl` is what tells these apart from the host: rules_rust
# maps a musl triple onto the gnu one's os/cpu constraints, so without it the
# gnu rustc and the host C toolchain would match here (MODULE.bazel).

platform(
    name = "x86_64-unknown-linux-musl",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@zig_sdk//libc:musl",
    ],
)

platform(
    name = "aarch64-unknown-linux-musl",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "@zig_sdk//libc:musl",
    ],
)
